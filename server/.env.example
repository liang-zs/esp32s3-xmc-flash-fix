# Copy to .env and edit. Any OpenAI-compatible vision model works: a cloud API or one you host yourself.
# ACTOR_* / PLANNER_* override LLM_* for one role (e.g. a fast actor and a stronger planner).

# --- Cloud API (OpenAI-compatible) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini          # any vision-capable chat model
LLM_API_KEY=
LLM_EXTRA_BODY='{}'
# Prices per million tokens: cache-hit input, cache-miss input, output (same currency). Fills `cost` in
# ~/.hidagent/runs.jsonl and /api/runs; leave unset to record tokens only.
# LLM_PRICE=0.1,1,2
# Off-peak prices; peak hours are workdays in Beijing time (DeepSeek: 9-12,14-18), the rest is off-peak.
# LLM_PRICE_IDLE=0.05,0.5,1
# LLM_PEAK_HOURS=9-12,14-18
# Newer OpenAI models want max_completion_tokens instead of max_tokens; "auto" (default) detects it.
# LLM_TOKEN_PARAM=auto            # auto | max_tokens | max_completion_tokens

# Added to routine actor calls only (thinking off: about 2x faster). The actor still thinks when its last
# action changed nothing on screen or its reply was rejected. Unset = always think (the old behaviour).
# ACTOR_FAST_BODY='{"thinking": {"type": "disabled"}}'   # DeepSeek; Qwen3: {"chat_template_kwargs": {"enable_thinking": false}}

# Draw a labeled 100-unit coordinate grid on the actor's screenshots (traces keep the clean frame).
# iPhone 11 aim test: thinking replies hit 15/16 keypad keys with it, 6/16 without.
# ACTOR_GRID=1

# The phone's AssistiveTouch Custom Actions: Double-Tap = Home (Single-Tap = Open Menu, Long Press = None).
# Then "home" double-taps the floating button instead of opening its menu. Leave unset otherwise: on a phone
# without that action, a double tap opens the menu and the second tap may hit something else.
# AT_DOUBLE_TAP_HOME=1

# --- Local model (optional): vLLM, SGLang, llama.cpp server, Ollama, ... ---
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=Qwen3.8-Flash-Next
# LLM_API_KEY=
# Qwen3.8 is tested; turn its thinking mode off for fast, short replies:
# LLM_EXTRA_BODY='{"chat_template_kwargs": {"enable_thinking": false}}'

# --- Per-role overrides (optional) ---
# ACTOR_MODEL=...      picks one action per screenshot: fast matters most
# PLANNER_MODEL=...    writes and repairs the plan

AIRPLAY_NAME='iPhone Agent'   # receiver name shown in the phone's Screen Mirroring list
PORT=8890                     # web UI
DEVICE_PORT=7300              # the ESP32 board connects here
# 1: verbose logs + one trace folder per agent run (prompts, replies, screenshots) in ~/.hidagent/traces
HIDAGENT_DEBUG=0
